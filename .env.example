# SouthStack Signaling Server URL
# Set this to the Tailscale IP of the machine running the signaling server.
# The server prints all available addresses on startup (npm run server).
#
# Examples:
#   Tailscale (cross-network):  VITE_SIGNALING_SERVER=http://100.64.0.1:3001
#   LAN (same WiFi):            VITE_SIGNALING_SERVER=http://192.168.1.100:3001
#   Local dev (single machine): VITE_SIGNALING_SERVER=http://localhost:3001
#
# If not set, defaults to http://<current-hostname>:3001

# VITE_SIGNALING_SERVER=http://100.x.x.x:3001
